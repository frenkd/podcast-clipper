# Copy to .env and fill in. .env is git-ignored: never commit it or paste keys into chats.
# The one key you need: transcription, reading the transcript, headlines, covers
OPENAI_API_KEY=
# Optional: Soniox (https://soniox.com) transcribes better, names especially; used instead of OpenAI when set
SONIOX_API_KEY=
# STT=openai forces OpenAI even with a Soniox key
# Host's first name, so the guest is detected correctly
CLIPPER_HOST=
# Models: SMART picks moments, FAST cleans the transcript, writes headlines and checks cover frames
OPENAI_MODEL_SMART=gpt-6.1-sol
OPENAI_MODEL_FAST=gpt-6-luna
# Where episode folders live (default ./projects)
# CLIPPER_DATA_DIR=./projects
# YouTube upload (optional): a "Desktop app" OAuth client from Google Cloud. Sign in with `./clip yt login`;
# the token gets the upload scope only and lives in ~/.config/podcast-clipper/ (YOUTUBE_TOKEN to move it)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
